# Web 入口端口，避免与 camera-recorder 的 8080 冲突
DIGITAL_LIFE_WEB_PORT=8090
# HTTPS 反向代理启用后设为 true，并填写浏览器实际访问的完整 origin
DIGITAL_LIFE_SECURE_COOKIE=false
DIGITAL_LIFE_TRUSTED_ORIGINS=
TZ=Asia/Shanghai
# 追剧表单中"联网搜索影视信息"依赖 Bangumi / TMDB 开放接口；设为 true 可完全关闭该可选功能
DIGITAL_LIFE_DISABLE_METADATA=false
# 在 themoviedb.org 免费申请的 API Key（v3）；填写后表单中的信息源可切换到 TMDB
DIGITAL_LIFE_TMDB_API_KEY=
# 可选：NAS 出网需要代理时填写（会传给 backend 容器，元数据搜索/封面下载走它）
# HTTP_PROXY=http://192.168.1.2:7890
# HTTPS_PROXY=http://192.168.1.2:7890
# ALL_PROXY=socks5h://192.168.1.2:7890
